---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign is_course = false %}
{% if page.collection == 'teaching' %}{% assign is_course = true %}{% endif %}
<div class="post{% if is_course %} course-page{% endif %}{% if page.header_art %} has-header-art{% endif %}">
  <header class="post-header">
    <div class="post-header-text">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description and page.description != "" %}
        <p class="post-description">
          {%- if page.description_filters -%}
            {%- comment -%} the subtitle doubles as a filter, see assets/js/publication-filters.js {%- endcomment -%}
            {%- for filter in page.description_filters -%}
              <a href="#{{ filter | slugify }}" class="pub-filter" data-filter="{{ filter | slugify }}" role="button" aria-pressed="false">{{ filter }}</a>
              {%- unless forloop.last %} · {% endunless -%}
            {%- endfor -%}
          {%- else -%}
            {{- page.description -}}
          {%- endif -%}
          {%- if is_course and page.category %} · {{ page.category }}{% endif -%}
        </p>
      {% endif %}
    </div>
    {% if is_course and page.img %}
      <img class="course-cover" src="{{ page.img | relative_url }}" alt="" aria-hidden="true">
    {% endif %}
    {% if page.header_art %}
      {% include {{ page.header_art | append: '.liquid' }} %}
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
