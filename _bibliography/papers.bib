  title     = {Revisiting Tardos's Framework for Linear Programming: Faster Exact
               Solutions using Approximate Solvers},
  abstract  = {We extend Tardos's framework for linear programming by replacing exact LP solves with approximate ones. We demonstrate that inverse polynomial accuracy in $n$ and $\log \bar\chi_A$ suffices to solve any LP exactly. By incorporating van den Brand's recent algorithm, we achieve $O(mn^{\omega+1} \log(n)\log(\bar\chi_A+n))$ arithmetic operations, surpassing the Vavasis-Ye interior point method. Our approach combines approximate LP solutions using constructive proximity theorems to maintain low accuracy requirements while computing exact primal and dual solutions.},
  booktitle = {61st IEEE Annual Symposium on Foundations of Computer Science, FOCS
               2020},
  pages     = {931--942},
  publisher = {IEEE},
  year      = {2020},
