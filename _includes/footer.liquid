{% capture footer_contents %}
  &copy; {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
  <span class="footer-credits">
    <img src="{{ '/assets/img/saluting-face.svg' | relative_url }}" alt="Salute" class="credit-salute">
    to
    <a
      href="https://github.com/alshedivat/al-folio"
      target="_blank"
      rel="noopener noreferrer"
      title="Thanks to the al-folio theme and its contributors"
    ><i class="fa-brands fa-github credit-logo" aria-hidden="true"></i>al-folio</a>
    &amp;
    <a
      href="https://zulip.com/"
      target="_blank"
      rel="noopener noreferrer"
      title="Thanks to Zulip for its sponsorship"
    ><img src="{{ '/assets/img/zulip-icon-circle.svg' | relative_url }}" alt="" class="credit-logo zulip-logo">Zulip</a>
  </span>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
