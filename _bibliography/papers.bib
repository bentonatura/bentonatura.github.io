  author = {Natura, Bento and Neuwohner, Meike and Weltge, Stefan},
  keywords = {Optimization and Control (math.OC), Computational Geometry (cs.CG), Discrete Mathematics (cs.DM), Data Structures and Algorithms (cs.DS), FOS: Mathematics, FOS: Mathematics, FOS: Computer and information sciences, FOS: Computer and information sciences},
  title = {The Pareto cover problem},
  abstract = {We introduce an optimization problem focused on selecting $k$ points in $[0,1]^n$ to minimize the expected cost of the cheapest point that dominates a random point from $[0,1]^n$. We demonstrate the problem is NP-hard for $k=2$ with binary coordinates, while providing an FPTAS (fully polynomial-time approximation scheme) for fixed $k$ under reasonable distributional assumptions. The work has applications where predefined products with specific feature subsets fulfill customer requests.},
  publisher = {arXiv},
  year = {2022},
  copyright = {Creative Commons Attribution 4.0 International}
}

