---
layout: default
---
<div class="post about-post">
  <article>
    <section class="about-hero">
      <header class="post-header">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            <span class="first-name">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
          {% if page.cv_pdf %}
            <a href="{{ page.cv_pdf | relative_url }}" class="cv-link" title="CV" aria-label="Download CV">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M14 3v4a1 1 0 0 0 1 1h4"/>
                <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/>
                <path d="M11 12.5a1.5 1.5 0 0 0 -3 0v3a1.5 1.5 0 0 0 3 0"/>
                <path d="M13 11l1.5 6l1.5 -6"/>
              </svg>
            </a>
          {% endif %}
        </h1>
        <p class="desc">{{ page.subtitle }}</p>
      </header>

      {% comment %}
        The photo column spans the name and the bio. The collapsible
        "Background & Education" block is rendered below the hero so that
        expanding it doesn't stretch the photo.
      {% endcomment %}
      {% assign about_parts = content | split: '<details' %}
      <div class="about-copy clearfix">{{ about_parts | first }}</div>

      {% if page.profile %}
        <aside class="profile about-profile">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: 768px) 330px, 260px{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
          {% if page.social %}
            <div class="contact-icons">{% social_links %}<img src="{{ '/assets/img/arsenal.svg' | relative_url }}" alt="Arsenal FC" title="Arsenal FC" class="arsenal-icon"></div>
            <script>
              // The jekyll-socials gem derives tooltips from the data key
              // ("Scholar userid", "Cv pdf", …); relabel them to clean names by icon type.
              (function () {
                var labels = {
                  'fa-envelope': 'Email', 'ai-cv': 'CV', 'fa-linkedin': 'LinkedIn',
                  'ai-google-scholar': 'Google Scholar', 'ai-dblp': 'DBLP', 'ai-orcid': 'ORCID',
                  'ai-arxiv': 'arXiv', 'ai-semantic-scholar': 'Semantic Scholar', 'ai-inspire': 'INSPIRE-HEP',
                  'fa-github': 'GitHub', 'fa-x-twitter': 'X', 'fa-mastodon': 'Mastodon',
                  'fa-bluesky': 'Bluesky', 'fa-youtube': 'YouTube', 'fa-google-scholar': 'Google Scholar'
                };
                document.querySelectorAll('.contact-icons a').forEach(function (a) {
                  var icon = a.querySelector('i');
                  if (!icon) return;
                  var label = null;
                  icon.classList.forEach(function (c) { if (labels[c]) label = labels[c]; });
                  if (label) { a.setAttribute('title', label); a.setAttribute('aria-label', label); }
                });
              })();
            </script>
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </aside>
      {% endif %}
    </section>

    {% if about_parts.size > 1 %}
      <div class="about-more-wrap">
        {%- for part in about_parts offset: 1 -%}<details{{ part }}{%- endfor -%}
      </div>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 id="selected-works" class="homepage-section-heading">
        <a href="{{ '/publications/' | relative_url }}">Selected Works</a>
      </h2>
      {% include selected_papers.liquid %}
      <a class="all-publications" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">&rarr;</span></a>
    {% endif %}

    <!-- News -->
    {% assign show_news = false %}
    {% if page.news %}{% assign show_news = true %}{% endif %}
    {% if page.announcements and page.announcements.enabled %}{% assign show_news = true %}{% endif %}
    {% if show_news %}
      <h2 id="news" class="homepage-section-heading">
        <a href="{{ '/news/' | relative_url }}">News</a>
      </h2>
      {% include news.liquid limit=true visible=4 %}
    {% endif %}

    <!-- Events -->
    {% if page.events %}
      <h2 id="events" class="homepage-section-heading">
        <a href="{{ '/events/' | relative_url }}">Events</a>
      </h2>
      {% include events.liquid %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2 id="posts" class="homepage-section-heading">
        <a href="{{ '/blog/' | relative_url }}">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
